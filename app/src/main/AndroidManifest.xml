<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotesLink">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NotesLink.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.NoteEditActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ArchiveActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TrashActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LabelsOverviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LabelNotesActivity"
            android:exported="false" />

        <activity
            android:name=".graph.GraphActivity"
            android:exported="false" />

    </application>

</manifest>
