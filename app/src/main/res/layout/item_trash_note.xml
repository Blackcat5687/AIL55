<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_dark"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/on_surface_dark"
            android:alpha="0.7"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textDaysLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/tag_highlight" />

    </LinearLayout>

    <ImageView
        android:id="@+id/buttonRestore"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="2dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_restore"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/trash_restore" />

    <ImageView
        android:id="@+id/buttonDeleteForever"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="2dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/trash_delete_forever" />

</LinearLayout>
