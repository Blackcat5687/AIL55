<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageEditBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <View
        android:id="@+id/imageEditScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/card_image_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: right-pointing close/save arrow at the start (top-right in RTL),
             archive + pin toggles at the end (top-left in RTL). -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/buttonSaveClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_right"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_close_note" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/buttonArchive"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_archive"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_archive" />

            <ImageView
                android:id="@+id/buttonPin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:padding="9dp"
                android:src="@drawable/ic_pin_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_pin" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/editTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:inputType="textCapSentences" />

                <EditText
                    android:id="@+id/editContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_content"
                    android:textSize="16sp"
                    android:background="@null"
                    android:gravity="top"
                    android:minLines="6"
                    android:inputType="textMultiLine|textCapSentences" />

            </LinearLayout>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/labelsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/labelChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- Bottom bar: note-style (colors/background) button at the start (bottom-right in RTL),
             three-dot "more options" button at the end (bottom-left in RTL). -->
        <LinearLayout
            android:id="@+id/bottomActionsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/buttonNoteStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_palette"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_note_style" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/undoRedoBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/buttonUndo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_undo"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_undo" />

                <ImageView
                    android:id="@+id/buttonRedo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_redo"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_redo" />

            </LinearLayout>

            <ImageView
                android:id="@+id/buttonMoreOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_more_options" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
